# Copy to cluster.local.env OUTSIDE frozen snapshots; do not store credentials.
# These are requests, not measured requirements. Verify Brown/Oscar settings first.
export REUSE_SSH_HOST="mliu171@ssh.ccv.brown.edu"
export REUSE_SOURCE_DIR="/REPLACE/shared/editable-source"
export REUSE_PROJECT_DIR="/REPLACE/shared/frozen-checkout"
export REUSE_ENV_DIR="/REPLACE/shared/cluster-venv"
export REUSE_RUN_ROOT="/REPLACE/shared/results"
export REUSE_CACHE_ROOT="/REPLACE/shared/model-cache"
export REUSE_LOOPVL_DIR="/REPLACE/shared/LoopVL"
export REUSE_MODEL_DIR="/REPLACE/shared/LoopVL-weights"
export REUSE_DATASET_DIR="/REPLACE/shared/datasets/scenes-v1" # Preparation only; copied to configs.
export REUSE_SITE_ENV="" # Optional script INSIDE snapshot with approved module loads.
export REUSE_PARTITION="REPLACE_WITH_GPU_PARTITION"
export REUSE_CPU_PARTITION="REPLACE_WITH_CPU_PARTITION"
export REUSE_ACCOUNT=""
export REUSE_QOS=""
# Optional CPU overrides. When unset, inherit REUSE_ACCOUNT/REUSE_QOS.
# Set an override to "" to let Slurm choose its default for that CPU flag.
# export REUSE_CPU_ACCOUNT=""
# export REUSE_CPU_QOS=""
export REUSE_GPU_FLAG="--gres" # Or --gpus, after consulting site documentation.
export REUSE_GPU_REQUEST="gpu:1" # For --gpus use 1; exactly one GPU per task.
export REUSE_CPUS="8"
export REUSE_MEM="32G"
export REUSE_TIME="01:00:00"
export REUSE_GPU_HOUR_CAP="30"
export REUSE_CACHE_READY="0" # Set 1 only after complete pinned offline-cache check.
export REUSE_DTYPE="auto" # Audit/official loader chooses; this does not cast weights.
export REUSE_MIN_VRAM_GIB="0" # Set only after measured model requirements.
